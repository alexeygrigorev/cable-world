; Engine configuration file.
; Лучше редактировать через Godot, когда проект начнет активно расти.

config_version=5

[application]

config/name="Мир Троссов"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://assets/branding/android_icon_192.png"
boot_splash/image="res://assets/branding/splash_loading.png"
boot_splash/fullsize=true
boot_splash/use_filter=false
boot_splash/bg_color=Color(0.85, 0.58, 0.28, 1)

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
