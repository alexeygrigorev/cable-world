{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cable-world.local/schemas/staging_catalog_candidate.schema.json",
  "title": "Staging-запись кандидата каталога",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "transport_type_id",
    "visit_status_id",
    "country",
    "latitude",
    "longitude",
    "localized",
    "operational_status",
    "source_ids",
    "source_urls",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Стабильный ASCII slug будущего TransportObject."
    },
    "transport_type_id": {
      "type": "string",
      "enum": [
        "cable_gondola",
        "cable_aerial_tram",
        "cable_urban",
        "cable_tourist",
        "funicular_classic",
        "funicular_water",
        "funicular_modern",
        "rail_cog",
        "rail_mountain",
        "rail_suspended",
        "elevator_vertical",
        "elevator_inclined",
        "elevator_panoramic",
        "suspended_train",
        "monorail",
        "suspended_ferry",
        "escalator_unusual",
        "special_transport_system",
        "unique_engineering_object"
      ]
    },
    "visit_status_id": {
      "type": "string",
      "enum": [
        "not_visited",
        "planned",
        "visited",
        "favorite"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "localized": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/localized_text"
      },
      "required": [
        "ru"
      ],
      "properties": {
        "ru": {
          "$ref": "#/$defs/required_localized_text"
        },
        "en": {
          "$ref": "#/$defs/localized_text"
        },
        "de": {
          "$ref": "#/$defs/localized_text"
        }
      }
    },
    "opened_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2100
    },
    "operator": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "operational_status": {
      "type": "string",
      "enum": [
        "active",
        "active_seasonal",
        "temporarily_closed_planned",
        "temporarily_closed_unplanned",
        "closed",
        "historical",
        "unknown"
      ]
    },
    "status_checked_at": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status_source_url": {
      "type": "string",
      "pattern": "^$|^https?://"
    },
    "status_note": {
      "type": "string"
    },
    "source_ids": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reviewed_by",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "candidate",
            "needs_changes",
            "approved",
            "rejected"
          ]
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "localized_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "required_localized_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
