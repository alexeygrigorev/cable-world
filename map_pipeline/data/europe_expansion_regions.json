  "source_strategy": {
    "admin_boundaries": {
      "primary_dataset": "Natural Earth Admin 0/1",
      "fallback_dataset": "OpenStreetMap boundary relations",
      "required_metadata": ["source_url", "license_note", "download_date", "processing_command"]
    },
    "relief": {
      "primary_dataset": "Copernicus DEM GLO-30",
      "fallback_datasets": ["EU-DEM", "NASA SRTM 1 Arc-Second Global"],
      "context_only_datasets": ["Natural Earth terrain"],
      "required_products_before_render": [
        "expanded_bounds_elevation_clip",
        "normalized_hillshade_mask",
        "elevation_band_polygons",
        "named_massif_sector_polygons",
        "lowland_exclusion_polygons"
      ],
      "placement_policy": "real_relief_source_or_named_massif_geometry",
      "forbidden_placement": ["random_decorative_mountains", "border_stopped_relief", "full_map_bitmap_patch"]
    },
    "cities_and_transport": {
      "seed_datasets": ["OpenStreetMap", "Wikidata"],
      "production_policy": "reviewed_candidates_only",
      "required_metadata": ["source_url", "license_note", "download_date", "review_status"]
    }
  },
  "global_rules": [
    {
      "id": "cross_border_relief_continuity",
      "rule": "Relief layers must continue across political borders when the real terrain continues.",
      "examples": ["Alps cannot stop at Germany", "Carpathians continue across Slovakia, Poland, Ukraine and Romania"]
    },
    {
      "id": "lowland_exclusions",
      "rule": "Known lowlands must be explicit exclusion or low-intensity context polygons before mountain glyphs are placed.",
      "required_exclusions": ["Po Valley", "Vienna Basin", "Swiss Plateau", "North European Plain"]
    },
    {
      "id": "source_backed_mountains",
      "rule": "Mountain and highland anchors must come from DEM-derived ridges, elevation bands, or documented named massif geometry, not decorative placement."
    },
    {
      "id": "detail_tiers",
      "rule": "High-detail regions need region/layer/city/source metadata first; low-detail remaining countries need admin, coastline, water and broad terrain coverage without pretending final relief accuracy."
    }
  ],
